{
  "name": "open-budget-bot",
  "version": "1.0.0",
  "description": "Professional Open Budget (Ochiq Budjet) Telegram Bot & Mini App with NestJS and Prisma",
  "author": "Open Budget Team",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build:admin": "cd admin-app && npm run build",
    "build": "npm run build:admin && nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node --max-old-space-size=4096 dist/main",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "solve:sample": "node new-budget-solve-captcha.js"
  },
  "dependencies": {
    "@2captcha/captcha-solver": "^1.3.8",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/serve-static": "^4.0.2",
    "@prisma/client": "^5.22.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "axios": "^1.7.9",
    "compression": "^1.8.1",
    "dotenv": "^16.4.7",
    "https-proxy-agent": "^9.1.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "socks-proxy-agent": "^10.1.0",
    "telegraf": "^4.16.3",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "prisma": "^5.22.0",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
