# Default Financial Settings (in UZS)
VOTE_REWARD=30000
REFERRAL_BONUS=5000
MIN_WITHDRAWAL=10000
VOTE_AUTO_APPROVE_HOURS=2

# ------------------------------------------------------------------------------
# 30-Minute Background System & Monitoring Configuration
# ------------------------------------------------------------------------------
# Interval in minutes for background health and captcha checks
HEALTH_CHECK_INTERVAL_MINUTES=30
HEALTH_CHECK_ENABLED=true

# Alert notification to admins if health drops (true/false)
HEALTH_ALERT_ADMINS=true

# ------------------------------------------------------------------------------
# External Microservice Bridge (REST API Connector)
# ------------------------------------------------------------------------------
# External voting/captcha solving/sms service URL (if using external microservice)
EXTERNAL_VOTING_API_URL=https://api.external-voting-service.uz/v1
EXTERNAL_VOTING_API_KEY=your_secure_api_key_here
EXTERNAL_SERVICE_ENABLED=false
EXTERNAL_SERVICE_TIMEOUT_MS=15000

# ------------------------------------------------------------------------------
# Proxy Pool Configuration (HTTP / HTTPS / SOCKS5)
# ------------------------------------------------------------------------------
# Global proxy list (comma-separated): http://user:pass@ip:port, socks5://ip:port
PROXY_ENABLED=false
PROXY_LIST=
PROXY_ROTATION_MODE=round_robin
PROXY_HEALTH_CHECK_ENABLED=true
