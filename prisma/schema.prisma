// Prisma schema for Multi-Bot Open Budget System (MySQL)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model BotInstance {
  id             Int       @id @default(autoincrement())
  name           String    // e.g. "Navbahor MFY Boti"
  token          String    @unique
  botUsername    String?
  mahallaId      String    // 12 xonali Mahalla ID, masalan: "055495798013"
  mahallaName    String    // masalan: "Navbahor MFY"
  openBudgetUrl  String    @db.Text // Open budget direct link
  boardId        String?   // e.g. "53"
  initiativeUuid String?   // e.g. "7710ad19-6734-4df9-ab25-a5d2de6facbf"
  targetVotes    Int       @default(5000)
  currentVotes   Int       @default(0)
  voteReward     Int       @default(30000)
  refBonus       Int       @default(5000)
  isRefActive    Boolean   @default(true) // Referal tizimi faolmi (true/false)
  isActive       Boolean   @default(true)
  status         String    @default("ONLINE") // ONLINE | STOPPED | ERROR
  avatarUrl      String?   @db.Text
  adminContact   String?   // Admin mas'ul shaxs kontakt ma'lumoti (masalan: "@mahalla_admin" yoki "+998901234567")
  description    String?   @db.Text // Ixtiyoriy izoh / eslatma / loyiha nomi
  grantedAmount  BigInt?   @default(0) // Loyiha qiymati / summasi (masalan: 1 240 000 000 so'm)
  lastError      String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  votes          Vote[]
  users          User[]
  agents         Agent[]
}

model User {
  id              Int              @id @default(autoincrement())
  telegramId      String           @unique
  username        String?
  firstName       String?
  lastName        String?
  phone           String?
  balance         Int              @default(0)
  totalEarned     Int              @default(0)
  totalWithdrawn  Int              @default(0)
  totalVotes      Int              @default(0)
  referralCode    String           @unique
  referredById    Int?
  referrer        User?            @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals       User[]           @relation("UserReferrals")
  botInstanceId   Int?             // Qaysi bot orqali birinchi kirgan
  botInstance     BotInstance?     @relation(fields: [botInstanceId], references: [id], onDelete: SetNull)
  agentId         Int?             // Qaysi agent havolasi orqali kirgan
  agent           Agent?           @relation("AgentReferredUsers", fields: [agentId], references: [id], onDelete: SetNull)
  agentsManaged   Agent[]
  role            String           @default("USER") // USER | ADMIN | AGENT
  isBanned        Boolean          @default(false)
  openBudgetJwt   String?          @db.Text // OpenBudget Citizen JWT Token
  openBudgetRefresh String?        @db.Text
  step            String?          // For bot conversation state
  tempData        String?          @db.Text // JSON state storage for multi-step flows
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  votes           Vote[]
  withdrawals     Withdrawal[]
  rewardsReceived ReferralReward[] @relation("RefereeRewards")
  rewardsGiven    ReferralReward[] @relation("ReferrerRewards")
}

model Agent {
  id            Int          @id @default(autoincrement())
  botInstanceId Int
  botInstance   BotInstance  @relation(fields: [botInstanceId], references: [id], onDelete: Cascade)
  userId        Int?         // Agar botdagi Telegram foydalanuvchi bo'lsa
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  name          String       // Agent ismi (masalan: "Azizbek (Maktab faoli)")
  phone         String?
  telegramId    String?      // Agent Telegram ID
  telegramUser  String?      // Agent Telegram username (@...)
  code          String       @unique // Unikal referral kod (masalan: "ag_1", "ag_azizbek")
  rewardPerVote Int          @default(5000) // Har bir ovoz uchun agent komissiyasi
  totalVotes    Int          @default(0)    // Jami tasdiqlangan ovozlar
  totalEarned   Int          @default(0)    // Jami ishlagan summasi
  totalPaid     Int          @default(0)    // To'lab berilgan summa
  balance       Int          @default(0)    // To'lanishi kerak bo'lgan qoldiq balans
  lastReceiptUrl String?     @db.Text       // Oxirgi to'lov cheki rasmi URL
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  votes         Vote[]
  referredUsers User[]       @relation("AgentReferredUsers")
}

model Initiative {
  id             Int      @id @default(autoincrement())
  openBudgetId   String   @unique
  mahallaId      String?
  mahallaName    String?
  boardId        String?
  initiativeUuid String?
  url            String?  @db.Text
  title          String   @db.Text
  region         String?
  district       String?
  category       String?
  targetVotes    Int      @default(5000)
  currentVotes   Int      @default(0)
  pricePerVote   Int      @default(4500)
  rewardPerVote  Int      @default(30000)
  isActive       Boolean  @default(true)
  isDefault      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  votes          Vote[]
}

model Vote {
  id             Int          @id @default(autoincrement())
  userId         Int
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  botInstanceId  Int?
  botInstance    BotInstance? @relation(fields: [botInstanceId], references: [id], onDelete: SetNull)
  initiativeId   Int?
  initiative     Initiative?  @relation(fields: [initiativeId], references: [id], onDelete: SetNull)
  agentId        Int?
  agent          Agent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)
  agentReward    Int          @default(0)
  phone          String       // Global unikal tekshiruv ushbu maydon bo'yicha qilinadi!
  status         String       @default("PENDING_VERIFICATION") // PENDING | PENDING_VERIFICATION | VERIFIED | REJECTED | FAILED
  rewardAmount   Int          @default(30000)
  sessionId      String?
  jwtToken       String?      @db.Text // Citizen OpenBudget JWT Token
  refreshToken   String?      @db.Text
  captchaAnswer  String?
  smsCode        String?
  ipAddress      String?      // Foydalanuvchi IP manzili (Audit uchun)
  proxyUsed      String?      // Ovoz berishda ishlatilgan Proxy IP (Audit uchun)
  userAgent      String?      @db.Text
  errorMessage   String?      @db.Text
  createdAt      DateTime     @default(now())
  completedAt    DateTime?
}

model Withdrawal {
  id             Int       @id @default(autoincrement())
  userId         Int
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount         Int
  paymentMethod  String    // UZCARD | HUMO | PAYNET
  accountDetails String    // Card or Phone number
  cardHolder     String?
  status         String    @default("PENDING") // PENDING | APPROVED | REJECTED
  adminNote      String?   @db.Text
  receiptUrl     String?   @db.Text
  createdAt      DateTime  @default(now())
  processedAt    DateTime?
}

model ReferralReward {
  id          Int      @id @default(autoincrement())
  referrerId  Int
  refereeId   Int
  referrer    User     @relation("ReferrerRewards", fields: [referrerId], references: [id], onDelete: Cascade)
  referee     User     @relation("RefereeRewards", fields: [refereeId], references: [id], onDelete: Cascade)
  amount      Int
  reason      String   // "SIGNUP_BONUS" | "VOTE_BONUS"
  createdAt   DateTime @default(now())
}

model SponsorChannel {
  id          Int      @id @default(autoincrement())
  channelId   String   @unique
  title       String
  username    String?
  inviteLink  String   @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model OpenBudgetResponseLog {
  id           Int      @id @default(autoincrement())
  endpoint     String   // "CAPTCHA" | "REQUEST_SMS" | "VERIFY_SMS"
  phone        String?
  statusCode   Int?
  requestBody  String?  @db.Text
  responseBody String?  @db.LongText
  isSuccess    Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model BotSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String   @db.Text
  description String?  @db.Text
  updatedAt   DateTime @updatedAt
}

model BroadcastMessage {
  id                Int      @id @default(autoincrement())
  type              String   @default("CUSTOM_AD") // REMINDER | CUSTOM_AD
  slot              String?  // MORNING | EVENING | TEST
  targetBotId       Int?
  targetMahallaName String?
  text              String   @db.Text
  photoUrl          String?  @db.Text
  buttonsJson       String?  @db.Text
  totalUsers        Int      @default(0)
  sentCount         Int      @default(0)
  failedCount       Int      @default(0)
  durationMs        Int      @default(0)
  status            String   @default("COMPLETED") // COMPLETED | FAILED
  createdAt         DateTime @default(now())
}

model ProxyServer {
  id        Int      @id @default(autoincrement())
  url       String   @unique @db.VarChar(512) // to'liq proxy URL (http://user:pass@ip:port)
  host      String
  port      Int
  protocol  String   @default("http")
  isBlocked Boolean  @default(false) // Admin tomonidan qo'lda bloklanganmi
  note      String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SystemApiLog {
  id           Int      @id @default(autoincrement())
  action       String   // "SEND_OTP" | "VERIFY_OTP" | "CAPTCHA_SOLVE" | "VOTE_SYNC"
  phone        String?
  captchaKey   String?
  captchaExpr  String?
  captchaAns   Int?
  imagePath    String?  // captcha rasmining /app/public/ ga nisbatan yo'li (masalan "captchas/2026-08-22_998901234567_a1b2c3.png")
  httpStatus   Int?
  responseBody String?  @db.Text
  isSuccess    Boolean  @default(false)
  errorMessage String?  @db.Text
  createdAt    DateTime @default(now())
}
